# Server
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=postgres://user:password@localhost:5432/strememe

# Auth
WT_SECRET_KEY=replace_with_a_strong_secret
JWT_EXPIRE_IN=7d
CLIENT_ID=your_google_client_id
CLIENT_SECRET_KEY=your_google_client_secret

# TMDB
API_KEY=your_tmdb_api_key
API_ACCESS_TOKEN=your_tmdb_v4_access_token

# Email
EMAIL=your_email@example.com
PASSWORD=your_email_app_password
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain
MAILGUN_USERNAME=api

# Firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
