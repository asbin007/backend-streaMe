# =============================================================================
# AuraScreen API — environment reference
#
# Variables marked REQUIRED are validated at boot (src/config/env.ts). The
# process refuses to start without them, so a misconfigured deploy fails at
# rollout instead of 500-ing on the first request.
# =============================================================================

# --- Server ------------------------------------------------------------------
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000

# Origins allowed to call the API with credentials. CLIENT_URL is also used as
# the redirect target after Google OAuth.
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (REQUIRED) -----------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/aurascreen

# --- Auth (Clerk) ------------------------------------------------------------
# REQUIRED. Sessions are issued and verified by Clerk; this service no longer
# mints its own JWTs. Find it in the Clerk dashboard under API Keys.
# Must be the secret key ("sk_...") for the SAME instance whose publishable key
# the clients use, otherwise every request fails verification.
CLERK_SECRET_KEY=sk_test_replace_me

# Comma-separated origins allowed to present session tokens. CLIENT_URL is
# included automatically; add extra deploy previews or the mobile scheme here.
CLERK_AUTHORIZED_PARTIES=

# --- TMDB --------------------------------------------------------------------
# Omit to disable the TMDB proxy endpoints.
API_KEY=your_tmdb_api_key
API_ACCESS_TOKEN=your_tmdb_v4_access_token

# --- Email -------------------------------------------------------------------
# Omit Mailgun keys to disable OTP, password reset, and reminder emails.
EMAIL=your_email@example.com
PASSWORD=your_email_app_password
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain
MAILGUN_USERNAME=api

# --- Firebase ----------------------------------------------------------------
# Omit to disable push notifications.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
